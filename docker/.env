# Path to the project you want Auto-Claude to work on (mounted at /workspace)
PROJECT_PATH=C:\autoproj

# Claude authentication token (REQUIRED for Docker)
# Docker has no browser or system keychain, so the interactive OAuth flow won't work.
# Get your token by running: claude setup-token  (on a machine with a browser)
# CLAUDE_CODE_OAUTH_TOKEN=sk-ant-oat01-...

# GitHub fine-grained personal access token (REQUIRED for GitHub features)
# Create one at: https://github.com/settings/tokens?type=beta
# Required permissions: Contents (read), Metadata (read), Pull requests (read/write), Issues (read/write)
# GH_TOKEN=github_pat_...

# Git identity (used for commits made inside the container)
# GIT_USER_NAME=Your Name
# GIT_USER_EMAIL=you@example.com

# Optional: Set a VNC password (leave empty for no password)
# VNC_PASSWORD=mysecretpassword
